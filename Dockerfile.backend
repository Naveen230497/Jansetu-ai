# ==========================================
# ENTERPRISE MULTI-STAGE DOCKERFILE
# ==========================================
FROM python:3.11-slim as builder

WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

FROM python:3.11-slim-bookworm as production
WORKDIR /app

# Install system dependencies for WeasyPrint
RUN apt-get update && apt-get install -y \
    libpango-1.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    libcairo2 \
    libffi-dev \
    libgdk-pixbuf2.0-0 \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

# Security: Run as non-root user
RUN useradd -m jansetu_user
USER jansetu_user

# Copy installed dependencies and code
COPY --from=builder --chown=jansetu_user:jansetu_user /root/.local /home/jansetu_user/.local
COPY --chown=jansetu_user:jansetu_user backend/ ./backend/

ENV PATH=/home/jansetu_user/.local/bin:$PATH
ENV ENVIRONMENT=production

EXPOSE 8080
CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8080} --workers 4"]
